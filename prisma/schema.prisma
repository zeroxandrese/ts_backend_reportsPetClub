generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_CNN2")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  Name      String   @unique
  Lead      String   @default("Usr")
  Password  String
  Lastlogin DateTime @default(now())

  @@map("users")
}

model Tokens {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  idTBOrigin String   @db.ObjectId
  token      String
  created    DateTime

  @@map("tokens")
}

model CountUsers {
  uid         String  @id @default(auto()) @map("_id") @db.ObjectId
  count       Int
  statusCount Boolean

  @@map("countUsers")
}

model CountPets {
  uid         String  @id @default(auto()) @map("_id") @db.ObjectId
  count       Int
  statusCount Boolean

  @@map("countPets")
}

model CountImages {
  uid         String  @id @default(auto()) @map("_id") @db.ObjectId
  count       Int
  statusCount Boolean

  @@map("countImages")
}

model CountVideos {
  uid         String  @id @default(auto()) @map("_id") @db.ObjectId
  count       Int
  statusCount Boolean

  @@map("countVideos")
}

model CountPoints {
  uid   String @id @default(auto()) @map("_id") @db.ObjectId
  count Int

  @@map("countPoints")
}

model CountLikes {
  uid   String @id @default(auto()) @map("_id") @db.ObjectId
  count Int

  @@map("countLikes")
}

model CountReports {
  uid   String @id @default(auto()) @map("_id") @db.ObjectId
  count Int

  @@map("countReports")
}

model CountAlerts {
  uid   String @id @default(auto()) @map("_id") @db.ObjectId
  count Int

  @@map("countAlerts")
}

model CountComments {
  uid   String @id @default(auto()) @map("_id") @db.ObjectId
  count Int

  @@map("countComments")
}

model UserData {
  uid            String    @id @default(auto()) @map("_id") @db.ObjectId
  idTBUserOrigin String    @unique
  nombre         String
  sexo           String
  email          String
  latitude       Float?
  longitude      Float?
  edad           DateTime?
  role           String
  status         Boolean
  google         Boolean
  created        DateTime
  googleUserId   String?
  updated        DateTime

  @@map("userData")
}

model MediaData {
  uid             String   @id @default(auto()) @map("_id") @db.ObjectId
  idTBImageOrigin String   @unique
  uidUser         String
  img             String
  charged         DateTime
  actionPlan      String
  status          Boolean
  updated         DateTime

  @@map("mediaData")
}

model LikeData {
  uid            String   @id @default(auto()) @map("_id") @db.ObjectId
  idTBLikeOrigin String   @unique
  uidUser        String
  uidImg         String
  like           Int
  charged        DateTime
  status         Boolean
  updated        DateTime

  @@map("likeData")
}

model WhatsappInteractionData {
  uid                          String   @id @default(auto()) @map("_id") @db.ObjectId
  idTBWhatsappInteractioOrigin String   @unique
  BusinessId                   String
  uidUser                      String
  interaction                  Int
  charged                      DateTime
  status                       Boolean
  updated                      DateTime

  @@map("whatsappInteractionData")
}

model MapInteractionData {
  uid                      String   @id @default(auto()) @map("_id") @db.ObjectId
  idTBMapInteractionOrigin String   @unique
  BusinessId               String
  uidUser                  String
  interaction              Int
  charged                  DateTime
  status                   Boolean
  updated                  DateTime

  @@map("mapInteractionData")
}

model UsersConnectionData {
  uid                       String   @id @default(auto()) @map("_id") @db.ObjectId
  idTBUsersConnectionOrigin String   @unique
  uidUser                   String
  created                   DateTime
  statusConnect             Boolean
  updated                   DateTime

  @@map("usersConnectionData")
}

model PawsCount {
  uid                String   @id @default(auto()) @map("_id") @db.ObjectId
  idTBPwsCountOrigin String   @unique
  uidUser            String
  paws               Int
  lastUpdated        DateTime
  status             Boolean
  updated            DateTime

  @@map("pawsCount")
}

model RegisterBusiness {
  uid                  String   @id @default(auto()) @map("_id") @db.ObjectId
  typeUser             String
  name                 String
  latitude             Float
  longitude            Float
  image                String
  weekOpening          String
  weekClosing          String
  dateAttentionWeek    String
  weekendOpening       String
  weekendClosing       String
  dateAttentionWeekend String
  phone                Int
  email                String? @default("example@example.com")
  approved             Boolean @default(false)
  created              DateTime
  lastUpdated          DateTime
  status               Boolean

  @@map("registerBusiness")
}
